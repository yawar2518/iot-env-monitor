# =============================================================
# IoT Environmental Monitoring System — Environment Variables
# =============================================================
# Copy this file to .env and fill in your own values.
# NEVER commit .env to Git.
# =============================================================


# -------------------------------------------------------------
# DJANGO
# -------------------------------------------------------------

# Set to 1 in development, 0 in production. Never deploy with DEBUG=1.
DJANGO_DEBUG=1

# Generate a unique secret key for production with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-local-dev-secret-key-change-in-production

# Comma-separated list of allowed hosts. Use * only in local dev.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Which settings module Django loads. Switch to core.settings.production in prod.
DJANGO_SETTINGS_MODULE=core.settings.local


# -------------------------------------------------------------
# POSTGRESQL / TIMESCALEDB
# -------------------------------------------------------------

POSTGRES_DB=iot_monitor
POSTGRES_USER=iot_user
POSTGRES_PASSWORD=iot_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Full DSN used by Django — built from the values above.
# In local dev this stays as-is. In production replace with your managed DB URL.
DATABASE_URL=postgresql://iot_user:iot_password@db:5432/iot_monitor


# -------------------------------------------------------------
# REDIS
# -------------------------------------------------------------

# Used by both Celery (task broker) and Django Channels (channel layer).
REDIS_URL=redis://redis:6379/0


# -------------------------------------------------------------
# CELERY
# -------------------------------------------------------------

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0


# -------------------------------------------------------------
# MOSQUITTO MQTT BROKER
# -------------------------------------------------------------

MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883

# Backend service credentials — Django uses these to connect to Mosquitto.
MQTT_BACKEND_USERNAME=backend_service
MQTT_BACKEND_PASSWORD=backend_password

# Device credentials — flashed onto the ESP32.
# Each physical device gets its own username/password in production.
# For local dev a single shared credential is fine.
MQTT_DEVICE_USERNAME=esp32_device
MQTT_DEVICE_PASSWORD=device_password


# -------------------------------------------------------------
# DJANGO CHANNELS
# -------------------------------------------------------------

# Channel layer uses Redis. Same Redis instance, different DB index (1).
CHANNEL_LAYERS_REDIS_URL=redis://redis:6379/1


# -------------------------------------------------------------
# CORS — Frontend origin allowed to call the Django API
# -------------------------------------------------------------

CORS_ALLOWED_ORIGINS=http://localhost:5173


# -------------------------------------------------------------
# DEVICE IDENTITY
# -------------------------------------------------------------

# A unique identifier for the ESP32. Used as MQTT client ID and in DB records.
# In production each device gets a UUID. For local dev a fixed string is fine.
DEVICE_ID=esp32-dev-001